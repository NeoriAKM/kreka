<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.2.0 -->
<interface>
  <!-- interface-name kreka-la.ui -->
  <requires lib="gio" version="2.0"/>
  <requires lib="gtk" version="4.24"/>
  <requires lib="libadwaita" version="1.10"/>
  <object class="AdwApplicationWindow" id="wn">
    <property name="default-height">720</property>
    <property name="default-width">1280</property>
    <child>
      <object class="AdwToolbarView" id="tb">
        <child type="top">
          <object class="AdwHeaderBar" id="hb">
            <property name="valign">start</property>
            <child type="title">
              <object class="GtkSearchEntry" id="sb"/>
            </child>
            <child type="start">
              <object class="GtkBox" id="bx1">
                <property name="spacing">4</property>
                <child>
                  <object class="GtkButton" id="home">
                    <property name="icon-name">go-home</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="undo">
                    <property name="icon-name">go-previous</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="redo">
                    <property name="icon-name">go-next</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="end">
              <object class="GtkBox" id="bx2">
                <property name="spacing">4</property>
                <child>
                  <object class="GtkButton" id="settings">
                    <property name="icon-name">preferences-other</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="info">
                    <property name="icon-name">help-about</property>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="menu">
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="popover">
                      <object class="GtkPopoverMenu" id="po">
                        <property name="menu-model">
                          <menu id="mn">
                            <item>
                              <attribute name="action">win.pr</attribute>
                              <attribute name="icon">preferences-other</attribute>
                              <attribute name="label">Preferences</attribute>
                            </item>
                            <item>
                              <attribute name="action">win.ab</attribute>
                              <attribute name="icon">help-about</attribute>
                              <attribute name="label">About</attribute>
                            </item>
                          </menu>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwToastOverlay" id="tst">
            <child>
              <object class="GtkScrolledWindow" id="sw"/>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="AdwWindow" id="jswn-def">
    <property name="icon-name">notification</property>
    <property name="modal">True</property>
    <property name="title">Alert.</property>
    <property name="transient-for">wn</property>
    <child>
      <object class="AdwToolbarView" id="jstb-def">
        <child type="top">
          <object class="GtkHeaderBar" id="jshb-def">
            <property name="show-title-buttons">False</property>
            <property name="title-widget">
              <object class="GtkLabel" id="jswn-deftitle">
                <property name="css-classes">heading</property>
                <property name="hexpand">True</property>
                <property name="justify">center</property>
                <property name="label">Alert.</property>
                <property name="use-markup">True</property>
                <property name="vexpand">True</property>
              </object>
            </property>
            <property name="valign">start</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="jsbx-def">
            <property name="homogeneous">True</property>
            <property name="margin-bottom">10</property>
            <property name="margin-end">3</property>
            <property name="margin-start">3</property>
            <property name="margin-top">10</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="jsmsg-def">
                <property name="halign">center</property>
                <property name="hexpand">True</property>
                <property name="label">This is alert. Change this message in code.</property>
                <property name="valign">center</property>
                <property name="vexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="jsok-def">
                <property name="halign">center</property>
                <property name="label">OK</property>
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="AdwWindow" id="jswn-con">
    <property name="icon-name">notification</property>
    <property name="modal">True</property>
    <property name="title">Alert.</property>
    <property name="transient-for">wn</property>
    <child>
      <object class="AdwToolbarView" id="jstb-con">
        <child type="top">
          <object class="GtkHeaderBar" id="jshb-con">
            <property name="show-title-buttons">False</property>
            <property name="title-widget">
              <object class="GtkLabel" id="jswn-contitle">
                <property name="css-classes">heading</property>
                <property name="hexpand">True</property>
                <property name="justify">center</property>
                <property name="label">Confirm.</property>
                <property name="use-markup">True</property>
                <property name="vexpand">True</property>
              </object>
            </property>
            <property name="valign">start</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="jsbx-con">
            <property name="margin-bottom">10</property>
            <property name="margin-end">3</property>
            <property name="margin-start">3</property>
            <property name="margin-top">10</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="jsmsg-con">
                <property name="halign">center</property>
                <property name="hexpand">True</property>
                <property name="label">Are you sure?</property>
                <property name="valign">center</property>
                <property name="vexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="jsbx2-con">
                <property name="hexpand">True</property>
                <property name="homogeneous">True</property>
                <property name="margin-end">3</property>
                <property name="margin-start">3</property>
                <property name="spacing">10</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="GtkButton" id="jscn-con">
                    <property name="halign">center</property>
                    <property name="label">Cancel</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="jsok-con">
                    <property name="halign">center</property>
                    <property name="label">OK</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="AdwWindow" id="jswn-prmpt">
    <property name="icon-name">notification</property>
    <property name="modal">True</property>
    <property name="title">Alert.</property>
    <property name="transient-for">wn</property>
    <child>
      <object class="AdwToolbarView" id="jstb-prmpt">
        <child type="top">
          <object class="GtkHeaderBar" id="jshb-prmpt">
            <property name="show-title-buttons">False</property>
            <property name="title-widget">
              <object class="GtkLabel" id="jswn-prmpttitle">
                <property name="css-classes">heading</property>
                <property name="hexpand">True</property>
                <property name="justify">center</property>
                <property name="label">Prompt.</property>
                <property name="use-markup">True</property>
                <property name="vexpand">True</property>
              </object>
            </property>
            <property name="valign">start</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="jsbx-prmpt">
            <property name="homogeneous">True</property>
            <property name="margin-bottom">10</property>
            <property name="margin-end">3</property>
            <property name="margin-start">3</property>
            <property name="margin-top">10</property>
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>
            <child>
              <object class="GtkLabel" id="jsmsg-prmpt">
                <property name="halign">center</property>
                <property name="hexpand">True</property>
                <property name="label">Enter here...</property>
                <property name="valign">center</property>
                <property name="vexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="jsen-prmpt">
                <property name="margin-end">10</property>
                <property name="margin-start">10</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="jsbx2-prmpt">
                <property name="hexpand">True</property>
                <property name="homogeneous">True</property>
                <property name="margin-end">3</property>
                <property name="margin-start">3</property>
                <property name="spacing">10</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="GtkButton" id="jscn-prmpt">
                    <property name="halign">center</property>
                    <property name="label">Cancel</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="jsok-prmpt">
                    <property name="halign">center</property>
                    <property name="label">OK</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="AdwAboutWindow" id="abt">
    <property name="application-icon">kreka26</property>
    <property name="application-name">Kreka</property>
    <property name="copyright">2021-2026 progwi0</property>
    <property name="designers">progwi0</property>
    <property name="developer-name">progwi0</property>
    <property name="developers">progwi0
NeoriAKM</property>
    <property name="issue-url">https://github.com/progwi0/kreka/issues/</property>
    <property name="license-type">gpl-3-0</property>
    <property name="release-notes">&lt;ul&gt;&lt;li&gt;The application was completely rewritten in Ruby.&lt;/li&gt;&lt;li&gt;A transition to GTK4 and Libadwaita was carried out.&lt;/li&gt;&lt;/ul&gt;</property>
    <property name="release-notes-version">26.11</property>
    <property name="support-url">https://t.me/progwi0?direct</property>
    <property name="title">About.</property>
    <property name="transient-for">wn</property>
    <property name="version">26.11</property>
    <property name="website">https://progwi0.pp.ua/kreka</property>
  </object>
</interface>
